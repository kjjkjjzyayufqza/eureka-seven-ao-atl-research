# Default deny: only research source, English documentation and named metadata.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/NOTICE
!/requirements.txt
!/dependencies.lock.json
!/docs/
/docs/*
!/docs/*.md
!/scripts/
/scripts/*
!/scripts/*.py
!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/third_party/
/third_party/*
!/third_party/README.md
!/third_party/ed8pkg2glb/
/third_party/ed8pkg2glb/*
!/third_party/ed8pkg2glb/LICENSE
!/third_party/ed8pkg2glb/src/
/third_party/ed8pkg2glb/src/*
!/third_party/ed8pkg2glb/src/ed8pkg2glb.py
!/third_party/srw-og-infinite-battle-korean/
/third_party/srw-og-infinite-battle-korean/*
!/third_party/srw-og-infinite-battle-korean/LICENSE
!/third_party/srw-og-infinite-battle-korean/tools/
/third_party/srw-og-infinite-battle-korean/tools/*
!/third_party/srw-og-infinite-battle-korean/tools/csvb.py

# Private output roots remain ignored, including future nested content.
/analysis/
/extracted/
/converted/
/playable/
/previews/
/manifests/
__pycache__/
*.py[cod]
*.log
*.blend*
.env*
